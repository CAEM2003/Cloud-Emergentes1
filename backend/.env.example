# Opcional: si no defines DATABASE_URL, se usa SQLite en backend/contactos.db
# PostgreSQL local:
# DATABASE_URL=postgresql+psycopg2://usuario:clave@localhost:5432/nombre_bd
# Supabase: en Render suele fallar el host "db....supabase.co" (IPv6). Usa Session pooler en Connect:
# DATABASE_URL=postgresql+psycopg2://postgres.PROJECT_REF:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Opcional para el servidor (python -m app). En la nube Render define PORT automáticamente.
# HOST=0.0.0.0
# PORT=8000
